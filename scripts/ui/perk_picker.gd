extends CanvasLayer
class_name PerkPicker

# Level-up / reward screen: a red ribbon with the title and three parchment cards framed in
# the metal of their rarity (iron, bronze, silver, amethyst, gold), each with the perk's icon
# in a medallion. Pick one with the mouse or 1-3. The game is paused while it is open.
# Art: assets/ui/perks/ (generated by tools/gen_ui_art.py).

const FONT: FontFile = preload("res://assets/fonts/PressStart2P-Regular.ttf")
const ART := "res://assets/ui/perks/"
const RARITY_FILES := ["common", "uncommon", "rare", "epic", "legendary"]
const SCALE := 3.0
const CARD_SIZE := Vector2(92, 118) * SCALE
const INK := Color(0.24, 0.14, 0.08)
# Text: a pixel blackletter for the ribbon title, a clean pixel sans on the cards (Press
# Start 2P is too heavy to read on parchment). Both are only sharp at their grid sizes, so use
# these sizes and nothing in between.
const TITLE_FONT: FontFile = preload("res://assets/fonts/JacquardaBastarda9-Regular.ttf")
const BODY_FONT: FontFile = preload("res://assets/fonts/PixelifySans.ttf")
const TITLE_PX := 13 # 1 font pixel = 1 screen pixel; use multiples (26, 39)
const BODY_PX := 22 # Pixelify: a font pixel is 1000/11 units, so 11, 22, 33 are exact
# How hard each rarity's frame glows (common, uncommon: plain metal).
const GLOW := [0.0, 0.0, 0.5, 0.8, 1.0]
const GLOW_PAD := 12.0
# Vertical layout in card pixels (x SCALE), matching the art from tools/gen_ui_art.py:
# medallion 11-39, name, rarity, divider at 69, description, key hint. Every block has its
# own band so nothing touches the next one.
const ICON_Y := 25 * SCALE - 32
const NAME_Y := 42 * SCALE
const RARITY_Y := 56 * SCALE
const DESC_TOP := 73 * SCALE
const DESC_BOTTOM := 100 * SCALE
const KEY_Y := 102 * SCALE

static var _open: PerkPicker

static func is_open() -> bool:
	return is_instance_valid(_open)

static func offer(title: String, cards: Array, on_done: Callable = Callable()) -> void:
	var tree := Engine.get_main_loop() as SceneTree
	if not tree or not tree.current_scene or cards.is_empty():
		return
	var p := PerkPicker.new()
	p._title = title
	p._cards = cards
	p._on_done = on_done
	tree.current_scene.add_child(p)
	_open = p

var _title: String
var _cards: Array
var _on_done: Callable
var _buttons: Array = []
var _chosen: bool = false
var _t: float = 0.0
# Spam-click guard: a click only counts once the screen has been up a moment AND the mouse
# button has been released since it opened (the attack click that killed the enemy must
# not pick a card).
const ARM_DELAY_MS := 700
var _opened_ms: int = 0
var _released: bool = false

func _ready() -> void:
	for f: FontFile in [TITLE_FONT, BODY_FONT]:
		f.antialiasing = TextServer.FONT_ANTIALIASING_NONE
		f.hinting = TextServer.HINTING_NONE
		f.subpixel_positioning = TextServer.SUBPIXEL_POSITIONING_DISABLED
	_opened_ms = Time.get_ticks_msec()
	_released = not Input.is_mouse_button_pressed(MOUSE_BUTTON_LEFT)
	layer = 70 # above the level title card (50) and the trapdoor fade (60)
	process_mode = Node.PROCESS_MODE_ALWAYS
	get_tree().paused = true
	var dim := ColorRect.new()
	dim.color = Color(0.02, 0.01, 0.04, 0.0)
	dim.set_anchors_preset(Control.PRESET_FULL_RECT)
	dim.mouse_filter = Control.MOUSE_FILTER_IGNORE
	add_child(dim)
	dim.create_tween().tween_property(dim, "color:a", 0.78, 0.25)

	var vp := get_viewport().get_visible_rect().size
	var gap := 22.0
	var total := CARD_SIZE.x * _cards.size() + gap * (_cards.size() - 1)
	var top := (vp.y - CARD_SIZE.y) / 2.0 + 30.0
	_ribbon(Vector2(vp.x / 2.0, top - 80.0))
	for i in _cards.size():
		var b := _card(_cards[i], i)
		b.position = Vector2((vp.x - total) / 2.0 + i * (CARD_SIZE.x + gap), top)
		add_child(b)
		_buttons.append(b)
	var hint := _label("Click a card or press 1-%d" % _cards.size(), BODY_PX, Color(0.75, 0.7, 0.62), BODY_FONT)
	hint.add_theme_color_override("font_outline_color", Color(0, 0, 0))
	hint.add_theme_constant_override("outline_size", 4)
	hint.size = Vector2(vp.x, 24)
	hint.position = Vector2(0, top + CARD_SIZE.y + 10)
	add_child(hint)

	AudioManager.play_bank("gem", 0.0, 0.8)
	AudioManager.play_bank("heal", -6.0, 1.2)
	for i in _buttons.size():
		var b: Control = _buttons[i]
		var y := b.position.y
		b.modulate.a = 0.0
		b.position.y = y + 30
		b.rotation = deg_to_rad(-6.0 + 6.0 * i)
		var tw := b.create_tween()
		tw.tween_interval(0.1 * i)
		tw.tween_property(b, "modulate:a", 1.0, 0.18)
		tw.parallel().tween_property(b, "position:y", y, 0.32).set_trans(Tween.TRANS_BACK).set_ease(Tween.EASE_OUT)
		tw.parallel().tween_property(b, "rotation", 0.0, 0.32).set_trans(Tween.TRANS_BACK).set_ease(Tween.EASE_OUT)

func _ribbon(center: Vector2) -> void:
	var tex: Texture2D = load(ART + "ribbon.png")
	var r := TextureRect.new()
	r.texture = tex
	r.texture_filter = CanvasItem.TEXTURE_FILTER_NEAREST
	r.expand_mode = TextureRect.EXPAND_IGNORE_SIZE
	r.size = tex.get_size() * 3.0
	r.position = center - r.size / 2.0
	r.mouse_filter = Control.MOUSE_FILTER_IGNORE
	r.pivot_offset = r.size / 2.0
	add_child(r)
	var t := _label(_title.to_upper(), 33, Color(1.0, 0.86, 0.45), BODY_FONT)
	t.add_theme_color_override("font_outline_color", Color(0.25, 0.03, 0.05))
	t.add_theme_constant_override("outline_size", 6)
	t.autowrap_mode = TextServer.AUTOWRAP_OFF
	t.size = Vector2(r.size.x, 40)
	t.position = Vector2(r.position.x, r.position.y + 8)
	add_child(t)
	var s := _label("Choose a blessing", BODY_PX, Color(0.86, 0.8, 0.68), BODY_FONT)
	s.add_theme_color_override("font_outline_color", Color(0, 0, 0))
	s.add_theme_constant_override("outline_size", 4)
	s.size = Vector2(r.size.x, 24)
	s.position = Vector2(r.position.x, r.position.y + r.size.y)
	add_child(s)
	r.scale = Vector2(0.6, 1.0)
	r.create_tween().tween_property(r, "scale", Vector2.ONE, 0.25).set_trans(Tween.TRANS_BACK).set_ease(Tween.EASE_OUT)

func _label(text: String, size: int, color: Color, font: Font = FONT) -> Label:
	var l := Label.new()
	l.text = text
	l.add_theme_font_override("font", font)
	l.add_theme_font_size_override("font_size", size)
	l.add_theme_color_override("font_color", color)
	# The project theme outlines every label; on parchment that fattens the letters and fills
	# their gaps, so it is off unless a label asks for one.
	l.add_theme_constant_override("outline_size", 0)
	l.horizontal_alignment = HORIZONTAL_ALIGNMENT_CENTER
	l.autowrap_mode = TextServer.AUTOWRAP_WORD_SMART
	l.mouse_filter = Control.MOUSE_FILTER_IGNORE
	return l

func _card(card: Dictionary, index: int) -> TextureButton:
	var r: int = card["rarity"]
	var col: Color = Progression.RARITY_COLORS[r]
	var perk: Dictionary = Progression.PERKS[card["id"]]
	var b := TextureButton.new()
	b.texture_normal = load(ART + "card_%s.png" % RARITY_FILES[r])
	b.ignore_texture_size = true
	b.stretch_mode = TextureButton.STRETCH_SCALE
	b.texture_filter = CanvasItem.TEXTURE_FILTER_NEAREST
	b.size = CARD_SIZE
	b.pivot_offset = CARD_SIZE / 2.0
	b.focus_mode = Control.FOCUS_NONE
	# Glow behind the card: on hover, and always faintly for epic and legendary.
	var glow := Panel.new()
	var sb := StyleBoxFlat.new()
	sb.bg_color = Color(col, 0.0)
	sb.shadow_color = Color(col, 0.6)
	sb.shadow_size = 18
	sb.set_corner_radius_all(6)
	glow.add_theme_stylebox_override("panel", sb)
	glow.position = Vector2(6, 6)
	glow.size = CARD_SIZE - Vector2(12, 12)
	glow.show_behind_parent = true
	glow.mouse_filter = Control.MOUSE_FILTER_IGNORE
	glow.modulate.a = 0.45 if r >= 3 else 0.0
	glow.name = "Glow"
	b.add_child(glow)
	if GLOW[r] > 0.0:
		if r == 4:
			var rays := TextureRect.new()
			rays.texture = load(ART + "rays.png")
			rays.texture_filter = CanvasItem.TEXTURE_FILTER_NEAREST
			rays.expand_mode = TextureRect.EXPAND_IGNORE_SIZE
			rays.size = Vector2(500, 500)
			rays.position = CARD_SIZE / 2.0 - rays.size / 2.0
			rays.pivot_offset = rays.size / 2.0
			rays.show_behind_parent = true
			rays.mouse_filter = Control.MOUSE_FILTER_IGNORE
			rays.material = _additive()
			rays.modulate.a = 0.55
			rays.name = "Rays"
			b.add_child(rays)
		var neon := TextureRect.new()
		neon.texture = load(ART + "glow_%s.png" % RARITY_FILES[r])
		neon.texture_filter = CanvasItem.TEXTURE_FILTER_NEAREST
		neon.expand_mode = TextureRect.EXPAND_IGNORE_SIZE
		neon.size = CARD_SIZE + Vector2(GLOW_PAD, GLOW_PAD) * 2.0 * SCALE
		neon.position = -Vector2(GLOW_PAD, GLOW_PAD) * SCALE
		neon.mouse_filter = Control.MOUSE_FILTER_IGNORE
		neon.material = _additive()
		neon.modulate.a = GLOW[r]
		neon.name = "Neon"
		b.add_child(neon)
	var icon_path := ART + "icon_%s.png" % card["id"]
	if ResourceLoader.exists(icon_path):
		var ic := TextureRect.new()
		ic.texture = load(icon_path)
		ic.texture_filter = CanvasItem.TEXTURE_FILTER_NEAREST
		ic.expand_mode = TextureRect.EXPAND_IGNORE_SIZE
		ic.size = Vector2(64, 64)
		ic.position = Vector2(CARD_SIZE.x / 2.0 - 32, ICON_Y)
		ic.mouse_filter = Control.MOUSE_FILTER_IGNORE
		ic.name = "Icon"
		b.add_child(ic)
	# Name at one and a half times the text size; a long one drops to the text size rather
	# than overflowing.
	var inner := CARD_SIZE.x - 36
	var name_l := _label(String(perk["name"]), 33, INK, BODY_FONT)
	name_l.autowrap_mode = TextServer.AUTOWRAP_OFF
	if name_l.get_minimum_size().x > inner:
		name_l.add_theme_font_size_override("font_size", BODY_PX)
	var name_box := CenterContainer.new()
	name_box.position = Vector2(18, NAME_Y)
	name_box.size = Vector2(inner, 40)
	name_box.mouse_filter = Control.MOUSE_FILTER_IGNORE
	name_box.add_child(name_l)
	b.add_child(name_box)
	var rar_col: Color = col.darkened(0.5 if r <= 1 else 0.3)
	var rar := _label(String(Progression.RARITY_NAMES[r]).to_upper(), BODY_PX, rar_col, BODY_FONT)
	rar.position = Vector2(18, RARITY_Y)
	rar.size = Vector2(inner, 27)
	b.add_child(rar)
	var desc := _label(Progression.describe(card), BODY_PX, INK, BODY_FONT)
	desc.add_theme_constant_override("line_spacing", 2)
	desc.vertical_alignment = VERTICAL_ALIGNMENT_CENTER # one line or three, it sits mid-band
	desc.position = Vector2(20, DESC_TOP)
	desc.size = Vector2(CARD_SIZE.x - 40, DESC_BOTTOM - DESC_TOP)
	b.add_child(desc)
	var owned := Progression.value(card["id"])
	var foot := "[%d]" % (index + 1)
	if owned > 0:
		foot = "owned %s    %s" % [str(snappedf(owned, 0.01)), foot]
	var key := _label(foot, BODY_PX, INK.lightened(0.35), BODY_FONT)
	key.position = Vector2(18, KEY_Y)
	key.size = Vector2(inner, 27)
	b.add_child(key)
	if r == 4:
		var sp := _Sparkles.new()
		sp.size = CARD_SIZE
		sp.color = Color(1.0, 0.85, 0.4)
		sp.mouse_filter = Control.MOUSE_FILTER_IGNORE
		b.add_child(sp)
	b.pressed.connect(_click.bind(index))
	b.mouse_entered.connect(_hover.bind(b, true))
	b.mouse_exited.connect(_hover.bind(b, false))
	return b

func _additive() -> CanvasItemMaterial:
	var m := CanvasItemMaterial.new()
	m.blend_mode = CanvasItemMaterial.BLEND_MODE_ADD
	return m

func _hover(b: TextureButton, on: bool) -> void:
	if _chosen:
		return
	if on:
		AudioManager.play_bank("ui_select", -12.0)
	var r: int = _cards[_buttons.find(b)]["rarity"]
	var tw := b.create_tween().set_parallel()
	tw.tween_property(b, "scale", Vector2(1.06, 1.06) if on else Vector2.ONE, 0.12).set_trans(Tween.TRANS_SINE)
	tw.tween_property(b.get_node("Glow"), "modulate:a", 1.0 if on else (0.45 if r >= 3 else 0.0), 0.12)

func _process(delta: float) -> void:
	_t += delta
	# The icons breathe a little; legendary cards shimmer.
	for i in _buttons.size():
		var b: TextureButton = _buttons[i]
		var ic := b.get_node_or_null("Icon") as Control
		if ic:
			ic.position.y = ICON_Y + roundf(sin(_t * 2.4 + i) * 2.0)
		# The neon breathes; the stronger the rarity, the deeper and faster.
		var r: int = _cards[i]["rarity"]
		var neon := b.get_node_or_null("Neon") as Control
		if neon:
			var depth := 0.15 + 0.1 * (r - 2)
			neon.modulate.a = GLOW[r] * (1.0 - depth + depth * sin(_t * (1.6 + 0.6 * (r - 2)) + i))
		var rays := b.get_node_or_null("Rays") as Control
		if rays:
			rays.rotation = _t * 0.25

func _input(event: InputEvent) -> void:
	if event is InputEventMouseButton and not event.pressed:
		_released = true

func _click(index: int) -> void:
	if _released and Time.get_ticks_msec() - _opened_ms >= ARM_DELAY_MS:
		_choose(index)

func _unhandled_input(event: InputEvent) -> void:
	if event is InputEventKey and event.pressed and not event.echo:
		var i: int = event.keycode - KEY_1
		if i >= 0 and i < _cards.size():
			_choose(i)
			get_viewport().set_input_as_handled()

func _choose(index: int) -> void:
	if _chosen:
		return
	_chosen = true
	var card: Dictionary = _cards[index]
	Progression.take(card)
	AudioManager.play_bank("ui_confirm", -2.0)
	AudioManager.play_bank("magic_shield", -4.0, 1.2)
	for i in _buttons.size():
		var o: Control = _buttons[i]
		var tw := o.create_tween().set_parallel()
		if i == index:
			tw.tween_property(o, "scale", Vector2(1.14, 1.14), 0.12).set_trans(Tween.TRANS_BACK)
			tw.tween_property(o.get_node("Glow"), "modulate:a", 1.0, 0.1)
		else:
			tw.tween_property(o, "modulate:a", 0.0, 0.2)
			tw.tween_property(o, "position:y", o.position.y + 24, 0.2)
	await get_tree().create_timer(0.38, true, false, true).timeout
	get_tree().paused = false
	_open = null
	queue_free()
	var p := get_tree().get_first_node_in_group("player") as Node2D
	if p:
		CombatFX.floating_label(p.global_position + Vector2(0, -12), String(Progression.PERKS[card["id"]]["name"]).to_upper(), Progression.RARITY_COLORS[card["rarity"]], 1.0)
	if _on_done.is_valid():
		_on_done.call()

# Twinkling pixel stars along a legendary card's frame.
class _Sparkles extends Control:
	var color := Color.WHITE
	var _stars: Array = []
	var _t := 0.0

	func _ready() -> void:
		var rng := RandomNumberGenerator.new()
		for i in 9:
			var edge := rng.randi() % 4
			var p := Vector2(rng.randf() * size.x, rng.randf() * size.y)
			match edge:
				0: p.y = rng.randf_range(-4, 8)
				1: p.y = size.y - rng.randf_range(-4, 8)
				2: p.x = rng.randf_range(-4, 8)
				3: p.x = size.x - rng.randf_range(-4, 8)
			_stars.append({"p": p, "phase": rng.randf() * TAU, "speed": rng.randf_range(1.5, 3.0)})

	func _process(delta: float) -> void:
		_t += delta
		queue_redraw()

	func _draw() -> void:
		for s in _stars:
			var k: float = maxf(sin(_t * s["speed"] + s["phase"]), 0.0)
			if k <= 0.05:
				continue
			var p: Vector2 = (s["p"] as Vector2).floor()
			var arm := 1.0 + roundf(k * 3.0)
			var c := Color(color, k)
			draw_rect(Rect2(p - Vector2(arm, 0), Vector2(arm * 2 + 2, 2)), c)
			draw_rect(Rect2(p - Vector2(0, arm), Vector2(2, arm * 2 + 2)), c)
			draw_rect(Rect2(p, Vector2(2, 2)), Color(1, 1, 1, k))
